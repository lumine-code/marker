{
  "name": "marker",
  "author": "lumine-code",
  "description": "Host the marker layers drawn on the scrollbar and minimap.",
  "repository": "https://github.com/lumine-code/marker",
  "bugs": {
    "url": "https://github.com/lumine-code/marker/issues"
  },
  "keywords": [
    "overview-ruler",
    "scrollmap",
    "minimap",
    "annotation",
    "decoration",
    "layers"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "docs",
    "lib",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "marker.layer": {
      "versions": {
        "^1.0.0": "consumeMarkerLayer"
      }
    }
  },
  "providedServices": {
    "marker.registry": {
      "versions": {
        "1.0.0": "provideMarkerRegistry"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
